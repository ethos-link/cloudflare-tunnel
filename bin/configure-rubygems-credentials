# frozen_string_literal: true

require "json"
require "net/http"
require "uri"

owner = ENV.fetch("RUBYGEMS_OWNER")
abort "RUBYGEMS_OWNER must be a numeric account ID" unless owner.match?(/\A[0-9]+\z/)

def request_json(request)
  response = Net::HTTP.start(request.uri.host, request.uri.port, use_ssl: true, open_timeout: 10, read_timeout: 30) do |http|
    http.request(request)
  end
  abort "Credential request failed (HTTP #{response.code})" unless response.is_a?(Net::HTTPSuccess)
  JSON.parse(response.body)
end

url = URI(ENV.fetch("ACTIONS_ID_TOKEN_REQUEST_URL"))
url.query = URI.encode_www_form(URI.decode_www_form(url.query.to_s) + [["audience", "rubygems.org"]])
request = Net::HTTP::Get.new(url)
request["Authorization"] = "Bearer #{ENV.fetch("ACTIONS_ID_TOKEN_REQUEST_TOKEN")}"
jwt = request_json(request).fetch("value")
abort "Missing OIDC token" unless jwt.is_a?(String) && !jwt.empty?
puts "::add-mask::#{jwt}"

request = Net::HTTP::Post.new(URI("https://rubygems.org/api/v1/oidc/trusted_publisher/exchange_token"))
request["Content-Type"] = "application/json"
request["Accept"] = "application/json"
request.body = JSON.generate(jwt: jwt, owner: owner)
key = request_json(request).fetch("rubygems_api_key")
abort "Missing RubyGems API key" unless key.is_a?(String) && !key.empty?
puts "::add-mask::#{key}"
File.open(ENV.fetch("GITHUB_ENV"), "a") { |file| file.puts "GEM_HOST_API_KEY=#{key}" }
